backend/data/cache/

# Playwright browsers live at D:/orca-playwright, outside the repo. Ignored here
# too, so an accidental in-tree install cannot be committed.
.playwright/

# Ad-hoc browser probes; the committed loop is frontend/shot.mjs.
*.local.mjs

# Trained model weights and the SST training archive. Weights are a build
# artefact of `python -m orca.ml.train_frontcast`, and the archive is ~150 days
# of MUR SST that anyone can refetch from a public endpoint — neither belongs in
# git history.
backend/data/models/
backend/data/training/
