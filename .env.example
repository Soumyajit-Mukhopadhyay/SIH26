# ORCA — committed template. Copy to .env and fill in. Never put real values here.
# Verified live 2026-08-30 — see docs/CREDENTIALS_VERIFIED.md

# ---------- runtime ----------
ORCA_ENV=dev
ORCA_LOG_LEVEL=INFO
ORCA_API_HOST=127.0.0.1
ORCA_API_PORT=8000
ORCA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- persistence ----------
# driver: auto | sqlite | postgis   (auto = try postgis, fall back to sqlite and say so)
ORCA_DB_DRIVER=auto
ORCA_SQLITE_PATH=backend/data/orca.db
# Supabase hosted Postgres 17.6 + PostGIS 3.3.7 + pgvector 0.8.2.
#  - db.<ref>.supabase.co does NOT resolve for this project (no direct IPv4). Use the POOLER.
#  - region is ap-southeast-1, NOT ap-south-1.
#  - port 5432 = session mode (asyncpg prepared statements OK). 6543 = transaction mode
#    and would need statement_cache_size=0. We use 5432.
#  - '@' in the password is URL-encoded as %40.
DATABASE_URL=
# Local docker-compose Postgres 16 + PostGIS 3.4 (docker compose up -d):
DATABASE_URL_LOCAL=postgresql://orca:orca@127.0.0.1:5433/orca

# ---------- cache / queue (optional accelerators) ----------
# Unset REDIS_URL -> in-process TTL cache + APScheduler. Set it -> Redis cache + ARQ queue.
REDIS_URL=redis://127.0.0.1:6380/0

# ---------- LLM providers (groq primary -> groq backup -> gemini -> openrouter -> ollama) ----------
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- language plane ----------
SARVAM_API_KEY=
HF_TOKEN=
# Bhashini not supplied — additive third stack, dormant.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# ---------- ocean / satellite data ----------
CMEMS_USERNAME=
CMEMS_PASSWORD=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# MOSDAC not supplied — adapter written and dormant.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
# IMD JSON (fishermen / port / cyclone / lightning) needs a registered key +
# egress IP whitelist. The public catalogue lists endpoints, not keys:
# https://api.imd.gov.in/public/api_reference.html
# Register: https://api.imd.gov.in/public/register.php
# Without a key, ORCA still reads the public IMD CAP RSS for official warnings.
IMD_API_KEY=
DATA_GOV_IN_API_KEY=
# Tide predictions (https://www.worldtides.info/register)
WORLDTIDES_API_KEY=

# ---------- vessels ----------
AISSTREAM_API_KEY=
GFW_API_TOKEN=

# ---------- frontend / geo services ----------
CESIUM_ION_TOKEN=

# ---------- auth ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---------- observability ----------
# NOTE: US region host, not cloud.langfuse.com — see docs/CREDENTIALS_VERIFIED.md
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
